// profile for execution on dardel

executor.queueSize = 1000
singularity.enabled = true
singularity.autoMounts = true

process {
    executor = 'slurm'

    clusterOptions = "-A ${params.slurm_account}"
    queue          = 'shared'

    withLabel: 'small' { memory = { 8.GB * task.attempt }; time = { 1.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'ANGSD_CONSENSUS' { memory = { 16.GB * task.attempt }; time = { 1.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'ASTRAL' { memory = { 16.GB * task.attempt }; time = { 1.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'CONSENSUS' { memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'CRAM2BAM' { memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'EXTRACT_WINDOW_SEQ' { memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'IQTREE' { memory = { 4.GB * task.attempt }; time = { 1.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'PREPARE_MASK' { memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }

}