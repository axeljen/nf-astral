// profile for execution on dardel

process {
    executor = 'slurm'
    singularity.enabled = true
    singularity.autoMounts = true
    clusterOptions = "-A ${params.slurm_account}"
    queue          = 'shared'
    queueSize = 1000

    withLabel: 'small' { memory = { 8.GB * task.attempt }; time = { 1.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'ANGSD_CONSENSUS' { memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'ASTRAL' { memory = { 64.GB * task.attempt }; time = { 10.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'CONSENSUS' { memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'CRAM2BAM' { memory = { 32.GB * task.attempt }; time = { 4.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'EXTRACT_WINDOW_SEQ' { memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'IQTREE' { memory = { 32.GB * task.attempt }; time = { 8.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }
    withName: 'PREPARE_MASK' { memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt }; maxRetries = 3; errorStrategy = 'retry' }

}