// Replace these placeholder URLs with your built Singularity images.
process {
    withName: INDEX_REFERENCE {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: INDEX_VCF {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: MAKE_WINDOWS {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: PREPARE_MASK {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: MASK_GENOME {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: CONSENSUS {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: IDENTIFY_ALIGNMENT {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: VALIDATE_VCF_SAMPLES {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: CRAM2BAM {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: ANGSD_CONSENSUS {
        // This image must also provide samtools.
        container = 'oras://community.wave.seqera.io/library/angsd_samtools:862faaf8ff6f970f'
    }
    withName: EXTRACT_WINDOW_SEQ {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: EXTRACT_REF_WINDOW {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: BUILD_ALIGNMENT {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: FILTER_ALIGNMENT {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_htslib_samtools:239961118de7349d'
    }
    withName: IQTREE {
        container = 'oras://community.wave.seqera.io/library/iqtree:3.1.4--ac1bcca7a98d6055'
    }
    withName: COLLAPSE_TREE {
        container = 'oras://community.wave.seqera.io/library/newick_utils:1.6--307b922d414f6255'
    }
    // withName: COMBINE_TREES {
    //     container = 'https://containers.example.invalid/nf-species-tree/combine_trees.sif'
    // }
    withName: ASTRAL {
        container = 'oras://community.wave.seqera.io/library/astral-tree:5.7.8--e408656bb17a8421'
    }
}
