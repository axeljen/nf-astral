/*
 * nf-species_tree pipeline configuration
 */

params {
    // ---- required inputs ----
    reference          = null   // path to reference genome fasta used for SNP calling
    vcf                = null   // path to (multi-sample) VCF/BCF with SNP calls
    samplesheet         = null  // csv with columns: sample,mask  (per-sample positive/callable mask bed)
    bamfiles             = null  // file with one BAM or CRAM path per line; mutually exclusive with vcf

    // ---- window generation (bedtools makewindows) ----
    window_size        = 10000   // length (bp) of each window
    window_step         = 200000 // distance (bp) between the start of consecutive windows

    // ---- consensus building ----
    // 'iupac' encodes heterozygous SNPs as IUPAC ambiguity codes (bcftools consensus -I)
    // any other value is passed as the haplotype number to bcftools consensus -H
    consensus_mode      = 'iupac'
    angsd_mode          = 'random' // random read base, or 'majority' for the most frequent base
    angsd_seed           = 1      // random seed used by ANGSD -doFasta 1
    include_reference   = false  // add the (unmasked) reference sequence to each window alignment

    // ---- alignment missingness filtering ----
    max_site_missing    = 0.8    // drop alignment columns with more than this fraction of missing bases
    max_sample_missing  = 0.5    // drop sequences with more than this fraction of missing bases (after site filtering)
    min_samples         = 4      // minimum number of sequences required to keep a window alignment
    min_length           = 1000   // minimum length (bp) of a window alignment after filtering

    // ---- gene tree inference (IQ-TREE) ----
    iqtree_model         = 'MFP'
    bootstrap            = 1000  // number of (ultrafast) bootstrap replicates

    // ---- branch collapsing (Newick Utilities nw_ed) ----
    min_support          = 20    // collapse internal branches with support below this value (%)

    // ---- species tree (ASTRAL) ----
    astral_jar           = null  // optional path to astral.jar; if unset, the 'astral' executable on PATH is used

    outdir               = 'results'
    name                = 'nf-astral_tree'
    tracedir             = "${params.outdir}/pipeline_info"
    slurm_account         = 'uppmax2026-1-135'
}

manifest {
    name            = 'nf-species_tree'
    description     = 'Window-based consensus sequences, gene trees and ASTRAL species tree from BAM, CRAM, or SNP VCF data'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

includeConfig 'conf/containers.config'

singularity {
    enabled = true
    autoMounts = true
}

profiles {
    conda {
        process.conda           = "${projectDir}/environment.yml"
        singularity.enabled    = false
        conda.enabled          = true
    }

    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
    }

    test {
        params.window_size  = 2000
        params.window_step  = 20000
        params.bootstrap    = 100
    }

    dardel {
        includeConfig 'conf/dardel.config'
    }
    
    pelle {
        process.executor       = 'slurm'
        process.queue          = 'pelle'
        process.clusterOptions = "-A ${params.slurm_account}"
        singularity.enabled     = true
        singularity.autoMounts  = true
    }
}

process {
    cpus   = { 2 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 2.h * task.attempt }
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries = 2
}

timeline {
    enabled   = true
    file      = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.tracedir}/pipeline_dag.svg"
    overwrite = true
}
